# Copy to .env beside docker-compose.yml and edit.
# Every value is optional; the defaults work for a plain LAN install.

# Your timezone, so times match your clock. Without this the container uses UTC.
TZ=America/New_York

# Port to publish on the host.
WEB_PORT=8080

# Leave blank to have one generated and stored in the instance volume.
# Set it only if you want to manage the key yourself.
SECRET_KEY=

# Set to "production" ONLY when serving over HTTPS. It marks session cookies
# Secure, which means they are never sent over plain http — enabling this
# without TLS will stop you signing in.
FLASK_ENV=

# Set to 1 only when a reverse proxy you control sits in front of this and
# sets X-Forwarded-For. Without such a proxy, a client could forge the header
# to dodge the sign-in rate limit.
TRUST_PROXY_HEADERS=

# Optional unattended first admin. Leaving these blank is preferred: create the
# account interactively instead, so the password is never stored in a file.
#   docker compose exec cmms python create_admin.py
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
