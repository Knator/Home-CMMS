# Local development. Copy to .env and edit:  cp .env.example .env
#
# Every value is optional — the defaults work for a first run, so you can skip
# this file entirely. For a Docker deployment use .env.docker.example instead;
# it carries container-only settings such as WEB_PORT and TZ.

# Signs session cookies. Leave blank and one is generated on first run and
# stored at instance/secret_key. Set it only to manage the key yourself.
SECRET_KEY=

# Where the database lives. The default is a single SQLite file.
DATABASE_URL=sqlite:///instance/home_cmms.db

# Where uploaded attachments and photos are written.
UPLOAD_FOLDER=uploads

# Set to "production" ONLY when serving over HTTPS. It marks session cookies
# Secure, which means they are never sent over plain http — enabling this
# without TLS will stop you signing in.
FLASK_ENV=

# Largest single attachment, in MB. Restoring a backup is exempt from this,
# however large the archive.
MAX_UPLOAD_MB=50

# Closes the first-run setup page this many minutes after startup; 0 means no
# limit. Restart to reopen it.
SETUP_WINDOW_MINUTES=0

# Set to 1 only when a reverse proxy you control sits in front and sets
# X-Forwarded-For. Without such a proxy a client could forge the header to
# dodge the sign-in rate limit.
TRUST_PROXY_HEADERS=

# Interface and port for `python run.py`. `flask run` uses its own defaults.
HOST=127.0.0.1
PORT=5000

# The Werkzeug debugger executes arbitrary Python from the browser, so run.py
# refuses to start with this on and HOST set to anything but loopback.
FLASK_DEBUG=

# Set to 0 to stop the hourly PM check from starting — useful for CLI work.
SCHEDULER_ENABLED=1
