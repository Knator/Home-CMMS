# Copy to .env and edit. All values are optional for local development.

FLASK_ENV=development

# Required when FLASK_ENV=production; the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Defaults to sqlite:///instance/home_cmms.db (relative paths resolve against
# the project root). Leave unset unless you want the database somewhere else.
# DATABASE_URL=sqlite:///instance/home_cmms.db

# Defaults to the project's uploads/ directory.
# UPLOAD_FOLDER=/absolute/path/to/uploads
